<Window x:Class="PeripheralBattery.Ui.DeviceListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="外设电量"
        Width="336"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Border x:Name="Shell" Margin="8" CornerRadius="12" BorderThickness="1" Padding="6,8,6,8">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="1" Opacity="0.32" />
    </Border.Effect>
    <DockPanel>
      <Grid DockPanel.Dock="Top" Margin="8,4,4,6">
        <StackPanel>
          <TextBlock x:Name="TitleText" Text="外设电量" FontSize="15" FontWeight="SemiBold" />
          <TextBlock x:Name="SubtitleText" FontSize="11" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Button x:Name="RefreshButton" Content="刷新" Padding="8,3" Margin="0,0,2,0" Cursor="Hand" />
          <Button x:Name="CloseButton" Content="✕" Padding="8,3" Cursor="Hand" />
        </StackPanel>
      </Grid>
      <TextBlock x:Name="BannerText" DockPanel.Dock="Top" Margin="10,0,10,6" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" />
      <TextBlock x:Name="EmptyText" Margin="12,16,12,18" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
      <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Rows" />
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
