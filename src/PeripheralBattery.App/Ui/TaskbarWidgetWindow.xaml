<Window x:Class="PeripheralBattery.Ui.TaskbarWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="外设电量"
        Width="112"
        Height="32"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Border x:Name="Shell" CornerRadius="5" BorderThickness="1" Padding="8,0">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Canvas x:Name="DeviceIcon" Width="16" Height="16" VerticalAlignment="Center" />
      <Canvas Width="18" Height="16" Margin="5,0,0,0" VerticalAlignment="Center">
        <Rectangle x:Name="Body" Width="14" Height="9.2" RadiusX="1.5" RadiusY="1.5" StrokeThickness="1.25" Canvas.Left="0.4" Canvas.Top="3.4" />
        <Rectangle x:Name="Cap" Width="1.7" Height="4" RadiusX="0.5" Canvas.Left="14.7" Canvas.Top="6" />
        <Rectangle x:Name="Fill" Width="0" Height="6.2" RadiusX="0.7" Canvas.Left="1.7" Canvas.Top="4.9" />
        <Path x:Name="Bolt" Visibility="Collapsed" StrokeThickness="0.8" StrokeLineJoin="Round"
              Data="M 7.55,4.55 L 5.55,8.05 L 6.95,8.05 L 6.05,11.05 L 9.55,7.25 L 8.05,7.25 Z" />
      </Canvas>
      <TextBlock x:Name="ValueText" Margin="5,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>
  </Border>
</Window>
