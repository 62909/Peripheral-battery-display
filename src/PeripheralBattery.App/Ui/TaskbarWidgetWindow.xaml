<Window x:Class="PeripheralBattery.Ui.TaskbarWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="外设电量"
        Width="69"
        Height="32"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Border x:Name="Shell" CornerRadius="5" BorderThickness="1">
    <StackPanel x:Name="Strip" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" />
  </Border>
</Window>
