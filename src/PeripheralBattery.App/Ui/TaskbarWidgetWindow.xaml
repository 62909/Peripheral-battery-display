<Window x:Class="PeripheralBattery.Ui.TaskbarWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="外设电量"
        Width="84"
        Height="32"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Border x:Name="Shell" CornerRadius="5" BorderThickness="1" Padding="8,0">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Canvas Width="16" Height="12" VerticalAlignment="Center">
        <Rectangle x:Name="Body" Width="13" Height="8" RadiusX="1.4" RadiusY="1.4" StrokeThickness="1.2" Canvas.Left="0" Canvas.Top="2" />
        <Rectangle x:Name="Cap" Width="1.6" Height="4" RadiusX="0.4" Canvas.Left="13.4" Canvas.Top="4" />
        <Rectangle x:Name="Fill" Width="0" Height="4.6" RadiusX="0.6" Canvas.Left="1.6" Canvas.Top="3.7" />
      </Canvas>
      <TextBlock x:Name="ValueText" Margin="6,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>
  </Border>
</Window>
